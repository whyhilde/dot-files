: 1758964429:0;cat > simple_patch.diff << 'EOF'\
--- a/slock.c\
+++ b/slock.c\
@@ -270,6 +270,24 @@ drawscreen(Display *dpy, struct xrandr *rr, int screen)\
        XSetWindowBackground(dpy, lock->win, lock->colors[INIT]);\
        XClearWindow(dpy, lock->win);\
        XMapWindow(dpy, lock->win);\
+       \
+       // Ѓ�обавлу�ем текст\
+       GC textgc = XCreateGC(dpy, lock->win, 0, NULL);\
+       XFontStruct *font = XLoadQueryFont(dpy, "fixed");\
+       if (font) {\
+           char text[100];\
+           struct passwd *pw = getpwuid(getuid());\
+           snprintf(text, sizeof(text), "Hi, %s!", pw->pw_name);\
+           \
+           int text_width = XTextWidth(font, text, strlen(text));\
+           int x = (DisplayWidth(dpy, screen) - text_width) / 2;\
+           int y = DisplayHeight(dpy, screen) / 2;\
+           \
+           XSetForeground(dpy, textgc, WhitePixel(dpy, screen));\
+           XSetFont(dpy, textgc, font->fid);\
+           XDrawString(dpy, lock->win, textgc, x, y, text, strlen(text));\
+           XFreeFont(dpy, font);\
+       }\
+       XFreeGC(dpy, textgc);\
 }\
 \
 static void\
EOF\
\
patch -p1 < simple_patch.diff\
make clean && make && sudo make install
