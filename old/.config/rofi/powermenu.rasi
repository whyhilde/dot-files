@theme "/dev/null"
@theme "~/.config/rofi/colors.rasi"


configuration {
  font: "JetBrains Mono Bold 12";
  location: 0;
  show-icons: false;
  hide-scrollbar: true;
}


window {
  transparency:                "real";
  location:                    center;
  anchor:                      center;
  fullscreen:                  false;
  width:                       800px;
  x-offset:                    0px;
  y-offset:                    0px;

  enabled:                     true;
  margin:                      0px;
  padding:                     0px;
  border:                      0px solid;
  border-radius:               10px;
  border-color:                @blue;
  cursor:                      "default";
  background-color:            @base;
}


mainbox {
  enabled:                     true;
  spacing:                     15px;
  margin:                      0px;
  padding:                     30px;
  border:                      0px solid;
  border-radius:               0px;
  border-color:                @blue;
  background-color:            transparent;
  children:                    [ "inputbar", "listview" ];
}


inputbar {
  enabled:                     true;
  spacing:                     15px;
  margin:                      0px;
  padding:                     0px;
  border:                      0px;
  border-radius:               0px;
  border-color:                @blue;
  background-color:            transparent;
  text-color:                  @text;
  children:                    [ "textbox-prompt-colon", "prompt"];
}


dummy {
  background-color:            transparent;
}


textbox-prompt-colon {
  enabled:                     true;
  expand:                      false;
  str:                         "POWER";
  padding:                     12px;
  border-radius:               100%;
  background-color: @red;
  text-color:                  @base;
}


prompt {
  enabled:                     true;
  padding:                     12px;
  border-radius:               100%;
  background-color: @green;
  text-color:                  @base;
}


message {
  enabled:                     true;
  margin:                      0px;
  padding:                     12px;
  border:                      0px solid;
  border-radius:               100%;
  border-color:                @blue;
  background-color:            @surface0;
  text-color:                  @text;
}


textbox {
  background-color:            inherit;
  text-color:                  inherit;
  vertical-align:              0.5;
  horizontal-align:            0.5;
  placeholder-color:           @text;
  blink:                       true;
  markup:                      true;
}


error-message {
  padding:                     12px;
  border:                      0px solid;
  border-radius:               0px;
  border-color:                @blue;
  background-color:            @base;
  text-color:                  @text;
}


listview {
  enabled:                     true;
  columns:                     5;
  lines:                       1;
  cycle:                       true;
  dynamic:                     true;
  scrollbar:                   false;
  layout:                      vertical;
  reverse:                     false;
  fixed-height:                true;
  fixed-columns:               true;

  spacing:                     15px;
  margin:                      0px;
  padding:                     0px;
  border:                      0px solid;
  border-radius:               0px;
  border-color:                @blue;
  background-color:            transparent;
  text-color:                  @text;
  cursor:                      "default";
}


element {
  enabled:                     true;
  spacing:                     0px;
  margin:                      0px;
  padding:                     40px 10px;
  border:                      0px solid;
  border-radius:               100%;
  border-color:                @blue;
  background-color:            @surface0;
  text-color:                  @text;
  cursor:                      pointer;
}


element-text {
  font:                        "MesloLGS NF 34";
  background-color:            transparent;
  text-color:                  inherit;
  cursor:                      inherit;
  vertical-align:              0.5;
  horizontal-align:            0.5;
}


element selected.normal {
  background-color: @blue;
  text-color: @base;
}
