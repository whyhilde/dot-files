{
  "languages": {
    "Rust": {
      "tab_size": 4,
      "hard_tabs": true,
      "show_completion_documentation": true,
      "show_completions_on_input": true,
      "auto_indent_on_paste": true,
    }
  },
  "terminal": {
    "font_weight": 500.0
  },
  "disable_ai": true,
  "soft_wrap": "editor_width",
  "minimap": {
    "show": "never"
  },
  "auto_signature_help": true,
  "cursor_shape": "bar",
  "ui_font_weight": 500.0,
  "buffer_font_weight": 500.0,
  "theme": "Catppuccin Mocha - No Italics",
  "icon_theme": "Zed (Default)",
  "theme_overrides": {
    "Catppuccin Mocha - No Italics": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "border.variant": "#00000000",
      "border": "#00000000",
      "title_bar.background": "#181825",
      "panel.background": "#181825",
      "panel.focused_border": "#181825",
      "players": [
        {
          "cursor": "#cdd6f4",
        },
      ],
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": false,
  },
  "project_panel": {
    "dock": "left",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": true,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
//  "outline_panel": {
//    "default_width": 300,
//    "indent_guides": {
//      "show": "never",
//    },
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "scrollbar": {
    "show": "never",
    "axes": {
    },
    "cursors": true,
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "indent_guides": {
    "enabled": false,
  },
  "ui_font_family": "JetBrains Mono NF",
  "ui_font_size": 20.0,
  "buffer_font_family": "JetBrains Mono NF",
  "buffer_font_size": 22.0,
  "buffer_line_height": {
    "custom": 1.7999999523162842,
  },
  "agent_buffer_font_size": 20,
  "vim_mode": true,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "selection_highlight": false,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "never",
  "current_line_highlight": "all",
  "show_whitespaces": "none",
  "tab_size": 2,
  "auto_indent": false,
  "auto_indent_on_paste": false,
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "inline_code_actions": false,
  "lsp_document_colors": "none",
  "hover_popover_enabled": false,
  "format_on_save": "off",
  "autosave": "off",
  "auto_update": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 8.0,
  "vertical_scroll_margin": 8.0,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": false,
  "restore_on_startup": "empty_tab",
  "session": {
    "restore_unsaved_buffers": false,
  },
  "git": {
    "git_gutter": "hide",
    "inline_blame": {
      "enabled": false,
    },
  },
  "centered_layout": {
    "right_padding": 0.15,
    "left_padding": 0.15,
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  }
}
