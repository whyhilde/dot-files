{
  "logo": {
    "source": "~/.config/fastfetch/logos/zfetch.txt",
    "color": {
      "1": "#94e2d5",
    },
    "padding": {
      "left": 0,
      "top": 1,
      "bottom": 1,
      "right": 2,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "reset_#94e2d5",
        "at": "reset_#cdd6f4",
        "host": "reset_#94e2d5",
      },
    },
    {
      "type": "os",
      "key": "OS    ",
      "keyColor": "reset_#94e2d5",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "reset_#94e2d5",
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "reset_#94e2d5",
    },
    {
      "type": "shell",
      "key": "Shell ",
      "keyColor": "reset_#94e2d5",
      "format": "{pretty-name}",
    },
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
