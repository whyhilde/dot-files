{
  "logo": {
    "source": "artix",
    "color": {
      "1": "green",
      "2": "white",
    },
    "padding": {
      "left": 0,
      "top": 0,
      "bottom": 0,
      "right": 3,
    },
  },
  "display": {
    "separator": ": ",
    "size": {
      "maxPrefix": "GB",
      "ndigits": 2,
    },
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "white",
        "host": "green",
      },
    },
    {
      "type": "break",
    },
    {
      "type": "os",
      "keyColor": "green",
    },
    {
      "type": "host",
      "keyColor": "green",
    },
    {
      "type": "kernel",
      "keyColor": "green",
      "format": "{release}",
    },
    {
      "type": "uptime",
      "keyColor": "green",
    },
    {
      "type": "display",
      "compactType": "original-with-refresh-rate",
      "key": "Resolution",
      "keyColor": "green",
    },
    {
      "type": "wm",
      "keyColor": "green",
    },
    {
      "type": "initsystem",
      "keyColor": "green",
    },
    {
      "type": "packages",
      "keyColor": "green",
    },
    {
      "type": "shell",
      "keyColor": "green",
    },
    {
      "type": "terminal",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "keyColor": "green",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "green",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "green",
      "format": "{used} / {total}",
    },
    {
      "type": "swap",
      // "key": "Swap",
      "keyColor": "green",
      "format": "{used} / {total}",
    },
    {
      "type": "disk",
      "folders": "/",
      // "key": "Disk (/)",
      "key": "Disk",
      "keyColor": "green",
      "format": "{size-used} / {size-total}",
    },
    {
      "type": "locale",
      "keyColor": "green",
    },
    // {
    //   "type": "disk",
    //   "folders": "/home",
    //   "key": "Disk (/home)",
    //   "keyColor": "green",
    //   "format": "{size-used} / {size-total}",
    // },
    {
      "type": "break",
    },
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
