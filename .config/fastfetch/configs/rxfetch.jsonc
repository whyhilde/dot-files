{
  "logo": {
    "source": "artix2_small",
    "color": {
      "1": "white",
    },
    "padding": {
      "left": 0,
      "top": 1,
      "bottom": 0,
      "right": 3,
    },
  },
  "display": {
    "separator": "  ",
    "size": {
      "binaryPrefix": "jedec",
      "ndigits": 0,
      "spaceBeforeUnit": "never",
    },
  },
  "modules": [
    // {
    //   "type": "break",
    // },
    {
      "type": "os",
      "key": "os   ",
      "keyColor": "magenta",
      "format": "{name}",
    },
    {
      "type": "kernel",
      "key": "ker  ",
      "keyColor": "green",
      "format": "{release}",
    },
    {
      "type": "packages",
      "key": "pkgs ",
      "keyColor": "cyan",
      "format": "{all}",
    },
    {
      "type": "shell",
      "key": "sh   ",
      "keyColor": "blue",
      "format": "{pretty-name}",
    },
    {
      "type": "memory",
      "key": "ram  ",
      "keyColor": "yellow",
      "format": "{used} / {total}",
    },
    {
      "type": "initsystem",
      "key": "init ",
      "keyColor": "magenta",
      "format": "{name}",
    },
    {
      "type": "wm",
      "key": "wm   ",
      "keyColor": "green",
      "format": "{pretty-name}",
    },
    {
      "type": "uptime",
      "key": "up   ",
      "keyColor": "cyan",
    },
    {
      "type": "disk",
      "key": "disk ",
      "keyColor": "blue",
      "folders": "/",
      "format": "{size-used} / {size-total}",
    },
    // {
    //   "type": "break",
    // },
    // {
    //   "type": "custom",
    //   "format": "{##f9e2af}󰮯  {##f5c2e7}󰊠  {##a6e3a1}󰊠  {##89dceb}󰊠  {##89b4fa}󰊠",
    // },
  ],
}
