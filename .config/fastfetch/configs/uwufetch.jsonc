{
  "logo": {
    "source": "~/.config/fastfetch/logos/uwufetch.txt",
    // "color": {
    //   "1": "blue",
    // },
    "padding": {
      "left": 0,
      "top": 2,
      "bottom": 0,
      "right": 3,
    },
  },
  "display": {
    "separator": " ",
    "size": {
      "binaryPrefix": "jedec",
      "maxPrefix": "MB",
      "ndigits": 0,
      "spaceBeforeUnit": "always",
    },
  },
  "modules": [
    {
      "type": "title",
      // "color": {
      //   "user": "blue",
      //   "at": "white",
      //   "host": "blue",
      // },
    },
    {
      "type": "os",
      "key": "OS    ",
      // "keyColor": "blue",
      "format": "{pretty-name}",
    },
    {
      "type": "host",
      "key": "HOST  ",
      // "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      // "keyColor": "blue",
      "format": "{release}",
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      // "keyColor": "blue",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": "GPU   ",
      // "keyColor": "blue",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "MEMORY",
      // "keyColor": "blue",
      "format": "{used} | {total}",
    },
    {
      "type": "shell",
      "key": "SHELL ",
      // "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "PKGS  ",
      // "keyColor": "blue",
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      // "keyColor": "blue",
      "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m",
    },
    {
      "type": "colors",
      "block": {
        "range": [1, 7],
      },
    },
  ],
}
