{
  "logo": {
    "source": "~/.config/fastfetch/logo",
    "position": "top",
    "color": {
      "1": "#89b4fa",
    },
    "padding": {
      "left": 1,
      "top": 1,
      "bottom": 1,
      "right": 1,
    },
  },
  "display": {
    "separator": " ",
    "color": "#cdd6f4",
    "constants": [
      "\u001b[38;2;243;139;168m",
      "\u001b[38;2;250;179;135m",
      "\u001b[38;2;249;226;175m",
      "\u001b[38;2;166;227;161m",
      "\u001b[38;2;137;220;235m",
      "\u001b[38;2;116;199;236m",
      "\u001b[38;2;180;190;254m",
      "\u001b[38;2;203;166;247m",
      "\u001b[38;2;205;214;244m",
    ],
  },
  "modules": [
    {
      "type": "custom",
      "key": " ╭───────────╮",
    },
    {
      "type": "users",
      "key": " │ {$1} {$9}user    │",
      "format": "{name}",
      "outputColor": "#f38ba8",
    },
    {
      "type": "title",
      "key": " │ {$2}󰌢 {$9}host    │",
      "format": "{host-name}",
      "outputColor": "#fab387",
    },
    {
      "type": "os",
      "key": " │ {$3}󰻀 {$9}distro  │",
      "format": "{pretty-name}",
      "outputColor": "#f9e2af",
    },
    {
      "type": "kernel",
      "key": " │ {$4} {$9}kernel  │",
      "format": "{release}",
      "outputColor": "#a6e3a1",
    },
    {
      "type": "uptime",
      "key": " │ {$5} {$9}uptime  │",
      "outputColor": "#89dceb",
    },
    {
      "type": "packages",
      "key": " │ {$6}󰏔 {$9}pkgs    │",
      "outputColor": "#89b4fa",
    },
    {
      "type": "wm",
      "key": " │ {$7} {$9}wm      │",
      "format": "{pretty-name} {version}",
      "outputColor": "#b4befe",
    },
    {
      "type": "command",
      "key": " │ {$8}󰉉 {$9}ram     │",
      "text": "free -m | awk 'NR==2{printf \"%d | %d MB\",$3,$2}'",
      "outputColor": "#cba6f7",
    },
    {
      "type": "custom",
      "key": " ├───────────┤",
    },
    {
      "type": "colors",
      "key": " │ {$9}󱥚 {$9}colors  │",
      "symbol": "circle",
    },
    {
      "type": "custom",
      "key": " ╰───────────╯",
    },
    {
      "type": "break",
    },
  ],
}
