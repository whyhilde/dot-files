{
  "logo": {
    "source": "~/.config/fastfetch/logo",
    "position": "top",
    "color": {
      "1": "#cdd6f4",
    },
    "padding": {
      "left": 1,
      "top": 1,
      "bottom": 0,
      "right": 0,
    },
  },
  "display": {
    "separator": "  ",
    "color": "#cdd6f4",
    "constants": [
      "\u001b[38;2;205;214;244m",
      "\u001b[38;2;137;180;250m",
      "\u001b[38;2;250;179;135m",
      "\u001b[38;2;166;227;161m",
    ],
  },
  "modules": [
    {
      "type": "break",
    },
    {
      "type": "custom",
      "key": " ╭──────────────────────────────────╮",
    },
    {
      "type": "os",
      "key": " │ {$2}󰻀 {$1}distro",
      "format": "{$2}{pretty-name>22} {$1}│",
    },
    {
      "type": "kernel",
      "key": " │ {$3} {$1}kernel",
      "format": "{$3}{release>22} {$1}│",
    },
    {
      "type": "command",
      "key": " │ {$4} {$1}uptime",
      "text": "uptime -p | sed \"s/up //\"",
      "format": "{$4}{>22} {$1}│",
    },
    {
      "type": "packages",
      "key": " │ {$2}󰏔 {$1}pkgs  ",
      "format": "{$2}{all>22} {$1}│",
    },
    {
      "type": "shell",
      "key": " │ {$3} {$1}shell ",
      "format": "{$3}{pretty-name>22} {$1}│",
    },
    {
      "type": "wm",
      "key": " │ {$4} {$1}wm    ",
      "format": "{$4}{pretty-name>22} {$1}│",
    },
    {
      "type": "monitor",
      "key": " │ {$2}󰇄 {$1}screen",
      "format": "{$2}{>22} {$1}│",
    },
    {
      "type": "command",
      "key": " │ {$3}󰉉 {$1}ram   ",
      "text": "free -m | awk 'NR==2{printf \"%.1f GB / %.1f GB\",$3/1024,$2/1024}'",
      "format": "{$3}{>22} {$1}│",
    },
    {
      "type": "custom",
      "key": " ╰──────────────────────────────────╯",
    },
    {
      "type": "break",
    },
  ]
}
