{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "34",
      "2": "34",
    },
    "padding": {
      "left": 1,
      "top": 3,
      "bottom": 0,
      "right": 3,
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "type": "break",
    },
    {
      "type": "title",
      "keyWidth": 10,
    },
    {
      "type": "break",
    },
    {
      "type": "os",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "packages",
      "key": "󰏔 ",
      "keyColor": "34",  
    },
    {
      "type": "monitor",
      "format": "{width}x{height} @ {refresh-rate}Hz",
      "key": "󰇄 ",
      "keyColor": "34",
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "memory",
      "format": "{used} / {total}",
      "key": "󰉉 ",
      "keyColor": "34",
    },
    {
      "type": "break",
    },
    {
      "type": "colors",
      "symbol": "circle",
    },
    {
      "type": "break",
    },
  ]
}
