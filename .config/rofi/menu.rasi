@theme "/dev/null"
* {
  bg: #1e1e2e;
  fg: #cdd6f4;
  blue: #89b4fa;
  border-col: #181825;
  width: 550;
}


configuration {
  modi: "drun";
  font: "JetBrains Mono Medium 14";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  lines: 8;
  location: 0;
  hide-scrollbar: true;
  sidebar-mode: false;
}


element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}


window {
  height: 375px;
  background-color: @bg;
  border: 2px;
  border-color: @border-col;
  border-radius: 10px;
}


mainbox {
  background-color: @bg;
}


inputbar {
  children: [ "prompt", "entry" ];
  background-color: @bg;
  border-radius: 5px;
  padding: 2px;
}


prompt {
  background-color: @blue;
  padding: 6px;
  text-color: @bg;
  border-radius: 3px;
  margin: 20px 0px 0px 20px;
}


textbox-prompt-colon {
  expand: false;
  str: ":";
}


entry {
  padding: 6px;
  margin: 20px 0px 0px 10px;
  text-color: @fg;
  background-color: @bg;
  placeholder: "type something";
  blink: true;
}


listview {
  border: 0px 0px 0px;
  padding: 6px 0px 0px;
  margin: 10px 0px 0px 20px;
  columns: 1;
  background-color: @bg;
}


element {
  padding: 5px;
  background-color: @bg;
  text-color: @fg;
}


element-icon {
  size: 25px;
}


element selected {
  text-color: @blue;
}
