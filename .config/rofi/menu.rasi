@theme "/dev/null"
* {
  bg: #1e1e2ee6;
  fg: #cdd6f4;
  accent: #89b4fa;
  borderColor: #89b4fae6;
  width: 575;
}


configuration {
  font: "JetBrains Mono Medium 14";
  show-icons: false;
  location: 0;
  hide-scrollbar: true;
  sidebar-mode: false;
}


element-text, element-icon {
  background-color: inherit;
  text-color: inherit;
}


window {
  height: 400px;
  background-color: @bg;
  border: 3px;
  border-color: @borderColor;
  border-radius: 10px;
}


mainbox {
  background-color: @bg;
}


inputbar {
  children: [ "prompt", "entry" ];
  background-color: @bg;
  border-radius: 5px;
  padding: 2px;
}


prompt {
  background-color: @accent;
  padding: 6px;
  text-color: @bg;
  border-radius: 3px;
  margin: 20px 0px 0px 20px;
}


textbox-prompt-colon {
  expand: false;
  str: ":";
}


entry {
  padding: 6px;
  margin: 20px 0px 0px 10px;
  text-color: @fg;
  background-color: @bg;
  placeholder: "search";
  blink: true;
}


listview {
  columns: 1;
  background-color: @bg;
  border: 0px 0px 0px 0px;
  padding: 8px 15px 8px 15px;
  margin: 10px 0px 0px 20px;
}


element {
  padding: 5px;
  background-color: @bg;
  text-color: @fg;
}


element selected {
  text-color: @accent;
}
